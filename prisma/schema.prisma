generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  systemRole        String    @default("client") @map("system_role") @db.VarChar(50) // 'admin' | 'client'
  userType          String?   @map("user_type") @db.VarChar(50) // 'teacher' | 'student'
  isActive          Boolean   @default(true) @map("is_active")
  avatarUrl         String?   @map("avatar_url") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  classesTaught     Class[]           @relation("TeacherClasses")
  classEnrollments  ClassEnrollment[]

  unitProgress      UserUnitProgress[]
  quizSessions      QuizSession[]
  examResults       ExamResult[]

  @@map("users")
}

model Class {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  inviteCode  String?  @unique @map("invite_code") @db.VarChar(50)
  teacherId   String   @map("teacher_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teacher     User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  students    ClassEnrollment[]
  units       Unit[]
  exams       Exam[]

  @@index([teacherId])
  @@map("classes")
}

model ClassEnrollment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  status    String   @default("active") @db.VarChar(20) // 'pending' | 'active' | 'rejected'
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_enrollments")
}

model Unit {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId            String   @map("class_id") @db.Uuid
  title              String   @db.VarChar(500)
  description        String?  @db.Text
  isPublished        Boolean  @default(false) @map("is_published")
  isFlashcardEnabled Boolean  @default(true) @map("is_flashcard_enabled")
  isQuizEnabled      Boolean  @default(true) @map("is_quiz_enabled")
  isMatchEnabled     Boolean  @default(false) @map("is_match_enabled")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  class            Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  vocabItems       VocabItem[]
  quizSessions     QuizSession[]
  studentProgress  UserUnitProgress[]
  exams            Exam[]

  @@index([classId])
  @@map("units")
}

model Exam {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(255)
  duration    Int      // in minutes
  isEnabled   Boolean  @default(false) @map("is_enabled")
  isPublished Boolean  @default(false) @map("is_published")
  isRetakable Boolean  @default(false) @map("is_retakable")
  content     Json     @map("content")
  
  classId     String?  @map("class_id") @db.Uuid
  unitId      String?  @map("unit_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  results     ExamResult[]

  @@index([classId])
  @@index([unitId])
  @@map("exams")
}

model ExamResult {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  score       Int?
  answers     Json?
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_results")
}

model VocabItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId      String?  @map("unit_id") @db.Uuid // Optional to allow general vocab items
  word        String   @db.VarChar(500)
  ipa         String?  @db.VarChar(255)
  pos         String?  @db.VarChar(50) // 'n', 'v', 'adj', 'v phr', 'n phr', 'adj phr'
  vi          String   @db.Text
  image       String?  @db.VarChar(500)
  emoji       String?  @db.VarChar(10)
  tip         String?  @db.Text
  example     String?  @db.Text
  exampleVi   String?  @map("example_vi") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  quizAnswersAsQuestion QuizAnswer[] @relation("QuestionVocab")
  quizAnswersAsSelected QuizAnswer[] @relation("SelectedVocab")

  @@index([unitId])
  @@map("vocab_items")
}

model UserUnitProgress {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  
  masteryProgress    Int       @default(0) @map("mastery_progress") // % vocab mastered
  
  flashcardPlayCount Int       @default(0) @map("flashcard_play_count")
  quizPlayCount      Int       @default(0) @map("quiz_play_count")
  bestQuizScore      Int?      @map("best_quiz_score")
  matchPlayCount     Int       @default(0) @map("match_play_count")
  bestMatchTime      Int?      @map("best_match_time")

  testScore          Int?      @map("test_score")
  testCompletedAt    DateTime? @map("test_completed_at") @db.Timestamptz
  testAnswers        Json?     @map("test_answers")
  testResults        Json?     @map("test_results")
  activityHistory    Json?     @map("activity_history")

  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit               Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
  @@index([unitId])
  @@map("user_unit_progress")
}

model QuizSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  unitId       String?   @map("unit_id") @db.Uuid
  mode         String    @default("scored") @db.VarChar(20) // 'scored' | 'endless'
  score        Int?      // 0-100, NULL for endless
  correctCount Int       @default(0) @map("correct_count")
  totalCount   Int       @default(0) @map("total_count")
  durationMs   Int?      @map("duration_ms")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit         Unit?     @relation(fields: [unitId], references: [id])
  answers      QuizAnswer[]

  @@index([userId])
  @@map("quiz_sessions")
}

model QuizAnswer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  vocabItemId       String   @map("vocab_item_id") @db.Uuid
  selectedVocabId   String   @map("selected_vocab_id") @db.Uuid
  isCorrect         Boolean  @map("is_correct")
  questionOrder     Int      @map("question_order")

  session           QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabItem         VocabItem   @relation("QuestionVocab", fields: [vocabItemId], references: [id])
  selectedVocabItem VocabItem   @relation("SelectedVocab", fields: [selectedVocabId], references: [id])

  @@index([sessionId])
  @@map("quiz_answers")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  otpHash   String   @map("otp_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("password_reset_tokens")
}

model ConsultationRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(255)
  phone        String   @db.VarChar(50)
  email        String?  @db.VarChar(255)
  course       String   @db.VarChar(255)
  learningGoal String?  @map("learning_goal") @db.Text
  status       String   @default("pending") @db.VarChar(50) // 'pending' | 'contacted' | 'enrolled'
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("consultation_registrations")
}
